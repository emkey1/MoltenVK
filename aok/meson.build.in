# MoltenVK as a static library, for iSH-AOK (branch ish-aok). Generated by
# aok/gen-meson.py from aok/meson.build.in; edit those, not this file.
#
# Upstream builds with Xcode projects (or a macOS-only CMake), fetching its
# dependencies at build time. This builds the same sources for macOS, iOS and
# the iOS simulator from whatever cross file the consumer uses, with the three
# dependencies the library needs committed under aok/external at the
# revisions in ExternalRevisions/: SPIRV-Cross, Vulkan-Headers (C headers
# only) and cereal. SPIRV-Tools is left out (MVK_EXCLUDE_SPIRV_TOOLS): it only
# prints SPIR-V disassembly in debug logs.
project('MoltenVK', 'c', 'cpp', 'objc', 'objcpp',
  version: '1.4.2',
  meson_version: '>= 0.60',
  default_options: ['cpp_std=c++17', 'warning_level=0', 'buildtype=release',
                    'default_library=static', 'b_ndebug=true'])

@SOURCES@
defines = [
  '-DSPIRV_CROSS_NAMESPACE_OVERRIDE=MVK_spirv_cross',
  '-DMVK_FRAMEWORK_VERSION=' + meson.project_version(),
  '-DMVK_USE_METAL_PRIVATE_API=0',
  '-DMVK_EXCLUDE_SPIRV_TOOLS=1',
  # warn: errors and warnings reach the log, not every object created.
  '-DMVK_CONFIG_LOG_LEVEL=2',
]
flags = defines + [
  '-fvisibility=hidden',
  '-Wno-deprecated-declarations',
  '-Wno-vla-cxx-extension',
  '-Wno-unknown-warning-option',
  # As upstream's Xcode project (CLANG_WARN_UNGUARDED_AVAILABILITY = NO, iOS
  # 15.0): newer Metal is gated at run time by mvkOSVersionIsAtLeast, which
  # clang cannot see.
  '-Wno-unguarded-availability-new',
]

git_rev = configure_file(
  input: 'Templates/cmake/mvkGitRevDerived.h.in',
  output: 'mvkGitRevDerived.h',
  configuration: {'MVK_GIT_REV': 'v' + meson.project_version() + '-ish-aok'},
)

vulkan_inc = include_directories('aok/external/Vulkan-Headers/include')
inc = include_directories(
  'aok/external/Vulkan-Headers/include',
  'aok/external/SPIRV-Cross',
  'aok/external/cereal/include',
  'Common',
  'MoltenVKShaderConverter',
  'MoltenVK/MoltenVK/API',
  'MoltenVK/MoltenVK/Commands',
  'MoltenVK/MoltenVK/GPUObjects',
  'MoltenVK/MoltenVK/Layers',
  'MoltenVK/MoltenVK/OS',
  'MoltenVK/MoltenVK/Utility',
  'MoltenVK/MoltenVK/Vulkan',
  'MoltenVK/include',
)

libmoltenvk = static_library('MoltenVK',
  mvk_common_sources, mvk_converter_sources, mvk_sources, spirv_cross_sources, git_rev,
  include_directories: inc,
  c_args: flags, cpp_args: flags, objc_args: flags, objcpp_args: flags,
)

# A native (macOS) consumer links the frameworks through this dependency. A
# cross build for iOS is linked by Xcode, which names them itself.
framework_deps = []
if not meson.is_cross_build()
  framework_deps = [dependency('appleframeworks', modules: [
    'Foundation', 'Metal', 'QuartzCore', 'IOSurface', 'AppKit', 'IOKit'])]
endif
moltenvk_dep = declare_dependency(
  link_with: libmoltenvk,
  include_directories: vulkan_inc,
  dependencies: framework_deps,
)
meson.override_dependency('MoltenVK', moltenvk_dep)
